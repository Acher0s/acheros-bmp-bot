# Copy to .env and fill in. Never commit .env.

# --- Discord -----------------------------------------------------------------
# Bot token from the Discord developer portal (Bot > Reset Token).
DISCORD_BOT_TOKEN=

# --- Match report pages (cogs/report_cog.py) ----------------------------------
# Public address players open for report pages (what your reverse proxy serves).
REPORT_PUBLIC_URL=https://conjoined.balala.pro
# Where the report web server listens. When running with docker compose these two
# are overridden inside the container (0.0.0.0:8080); use the REPORT_HTTP_* values
# below to choose where it's published on the host instead.
REPORT_BIND_HOST=127.0.0.1
REPORT_PORT=8080

# docker compose only: host address/port the report pages are published on. Set the
# address to one your reverse proxy can reach (e.g. a private/VPN IP) if the proxy
# is on another machine; 127.0.0.1 keeps it local to this host.
REPORT_HTTP_BIND=127.0.0.1
REPORT_HTTP_PORT=8080

# --- Balatro server (cogs/bala_cog.py) ----------------------------------------
# Base address of the Balatro server's admin HTTP API (port 8790 on the server, or
# whatever your reverse proxy exposes it as). No trailing /admin.
#   e.g. https://bala-admin.example.com   or   http://10.0.0.5:8790
BALA_ADMIN_URL=
# Must match ADMIN_TOKEN in the Balatro server's .env.
BALA_ADMIN_TOKEN=
